{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "title",
        "language",
        "style_block",
        "character_sheet",
        "music",
        "shots"
    ],
    "properties": {
        "title": {
            "type": "string"
        },
        "language": {
            "type": "string"
        },
        "style_block": {
            "type": "string",
            "minLength": 10
        },
        "character_sheet": {
            "type": "string",
            "minLength": 10
        },
        "music": {
            "type": "object",
            "required": [
                "caption",
                "duration_s",
                "bpm",
                "key",
                "seed"
            ],
            "properties": {
                "caption": {
                    "type": "string"
                },
                "duration_s": {
                    "type": "number",
                    "minimum": 30,
                    "maximum": 120
                },
                "bpm": {
                    "type": "integer",
                    "minimum": 40,
                    "maximum": 200
                },
                "key": {
                    "type": "string"
                },
                "seed": {
                    "type": "integer"
                }
            }
        },
        "shots": {
            "type": "array",
            "minItems": 8,
            "maxItems": 12,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "reason",
                    "shot_size",
                    "image_prompt",
                    "motion_prompt",
                    "kb",
                    "narration",
                    "subtitle_en",
                    "seed"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^s[0-9]{2}$"
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 10
                    },
                    "shot_size": {
                        "enum": [
                            "wide",
                            "medium",
                            "close-up",
                            "insert"
                        ]
                    },
                    "image_prompt": {
                        "type": "string",
                        "minLength": 10
                    },
                    "motion_prompt": {
                        "type": "string",
                        "minLength": 5
                    },
                    "kb": {
                        "enum": [
                            "zoom_in",
                            "zoom_out",
                            "pan_left",
                            "pan_right"
                        ]
                    },
                    "narration": {
                        "type": "string",
                        "minLength": 2
                    },
                    "subtitle_en": {
                        "type": "string",
                        "minLength": 2
                    },
                    "seed": {
                        "type": "integer"
                    }
                }
            }
        }
    }
}